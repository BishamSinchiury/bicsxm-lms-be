# ============================================================
# LMS Backend — Environment Variables
# Copy to .env and fill in values before running.
# ============================================================

# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ---- PostgreSQL ----
POSTGRES_DB=lms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- Redis ----
# DB 0=cache, 1=OTP+throttle, 2=Celery broker, 3=Celery results, 4=course cache
REDIS_URL=redis://localhost:6379

# ---- MongoDB ----
# Requires a replica set for transaction support (even locally).
# docker compose starts one automatically via the mongo-init service.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_NAME=lms
MONGODB_TEST_NAME=lms_test_mongo

# ---- JWT ----
# Separate signing keys per role (REQUIRED in production)
JWT_SIGNING_KEY_ADMIN=change-me-admin-key
JWT_SIGNING_KEY_TEACHER=change-me-teacher-key
JWT_SIGNING_KEY_STUDENT=change-me-student-key
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=False
JWT_COOKIE_SAMESITE=Lax

# ---- OTP ----
OTP_HMAC_SECRET=change-me-otp-hmac-secret
OTP_LENGTH=6
OTP_TTL=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60

# ---- Email ----
# Console backend for dev (prints OTPs to terminal/Celery stdout); switch to SMTP for production / live email delivery.
# If EMAIL_HOST_PASSWORD is left blank with smtp.EmailBackend, backend auto-falls back to console backend with a warning.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Gmail SMTP setup:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password under Security -> 2-Step Verification -> App passwords.
# 3. Set the 16-character password below (without spaces) and uncomment these lines:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-16-char-app-password
# EMAIL_USE_TLS=True
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@lms.local

# ---- CORS & Frontend ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# ---- Throttling ----
THROTTLE_OTP_EMAIL=5/hour
THROTTLE_OTP_IP=10/hour
THROTTLE_LOGIN_EMAIL=10/hour
THROTTLE_LOGIN_IP=20/hour

# ---- User state cache (seconds) ----
USER_STATE_CACHE_TTL=15
